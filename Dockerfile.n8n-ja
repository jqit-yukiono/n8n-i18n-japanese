ARG N8N_VERSION=latest
ARG EDITOR_UI_ARCHIVE_URL

# n8nio/n8n は Docker Hardened Image (Alpine) で apk を持たないため、
# python3/jq 本体・依存共有ライブラリは別ステージの素の Alpine で取得してコピーする。
# n8nio/n8n 側の Alpine バージョンが変わったら揃える（現状 3.24 系）。
FROM alpine:3.24 AS python_base
# Alpine リポジトリの最新 python3/jq に追随したいのでバージョン固定はしない。
# hadolint ignore=DL3018
RUN apk add --no-cache python3 jq
# stdlib ディレクトリ (/usr/lib/python3.X) をワイルドカード COPY すると
# ディレクトリ名が落ちて内容が /usr/lib/ 直下に展開されてしまうため、
# /out 配下に絶対パスのまま複製し直して最終ステージへそのまま重ねる。
RUN set -eux; \
	stdlib_dir="$(python3 -c 'import sysconfig; print(sysconfig.get_path("stdlib"))')"; \
	mkdir -p "/out$(dirname "$stdlib_dir")"; \
	cp -a "$stdlib_dir" "/out$stdlib_dir"

FROM alpine:3.20 AS editor_ui
ARG EDITOR_UI_ARCHIVE_URL
RUN test -n "$EDITOR_UI_ARCHIVE_URL" || (echo "EDITOR_UI_ARCHIVE_URL is required" >&2; exit 1)
# editor-ui アーカイブ取得・展開専用の使い捨てステージ。
# curl/tar の Alpine リポ版に追随したいので APK バージョン固定はしない。
# hadolint ignore=DL3018
RUN apk add --no-cache curl tar
WORKDIR /work
RUN curl -fsSL "$EDITOR_UI_ARCHIVE_URL" -o editor-ui.tar.gz
RUN mkdir -p editor-ui-dist \
	&& tar -xzf editor-ui.tar.gz -C /work \
	&& test -d /work/editor-ui-dist

FROM n8nio/n8n:${N8N_VERSION}

COPY --from=editor_ui /work/editor-ui-dist /usr/local/lib/node_modules/n8n/node_modules/n8n-editor-ui/dist

ENV N8N_DEFAULT_LOCALE=ja

# --- Python3 (最新) ---
# n8n ワークフロー（Execute Command ノード等）から `python3` を呼べるよう同梱する。
# apk が無いので python_base ステージからバイナリ・stdlib・不足分の共有ライブラリを
# コピーする（libssl/libz 等は n8n ベースにすでにあるため対象外）。
COPY --from=python_base /out/ /
COPY --from=python_base /usr/lib/libpython3.*.so* /usr/lib/
COPY --from=python_base /usr/lib/libffi.so* /usr/lib/libmpdec.so* /usr/lib/libpanelw.so* /usr/lib/libreadline.so* /usr/lib/libsqlite3.so* /usr/lib/
COPY --from=python_base /usr/bin/python3.* /usr/bin/
USER root
RUN py_bin="$(ls /usr/bin/python3.* | head -n1)" \
	&& ln -sf "$py_bin" /usr/bin/python3 \
	&& ln -sf "$py_bin" /usr/bin/python
USER node

# --- jq (最新) ---
# n8n ワークフロー（Execute Command ノード等）から `jq` で JSON 加工できるよう同梱する。
# python3 と同じ理由で apk が無いため、python_base ステージからコピーする。
COPY --from=python_base /usr/bin/jq /usr/bin/
COPY --from=python_base /usr/lib/libjq.so* /usr/lib/libonig.so* /usr/lib/

# --- Claude Code CLI ---
# n8n ワークフロー（Execute Command ノード等）から `claude` を呼べるよう同梱する。
# 認証はイメージに焼き込まず、実行時の環境変数で外だしする:
#   ANTHROPIC_API_KEY        … API トークン方式
#   CLAUDE_CODE_OAUTH_TOKEN  … サブスク(OAuth)方式（`claude setup-token` で取得）
# どちらか一方をコンテナ env に渡せば切り替え可能。
#
# 同梱可否はビルド時 ARG INSTALL_CLAUDE_CODE で制御（デフォルト false=非同梱）。
# 同梱した場合も、実行時に認証 env がどちらも無ければ /usr/local/bin/claude の
# ラッパーが起動を拒否する（env 未設定では動かさない）。
# ベースは Docker Hardened Image (Alpine) で apk を持たないが node/npm/git は同梱済み。
# /usr/local/bin/claude（PATH内）にラッパーを置き、実行時に native 実体を exec する。
# 実体は symlink ではなく cp で退避する: npm prefix が /usr/local だと
# $(npm prefix -g)/bin/claude が /usr/local/bin/claude と一致し、直後にラッパーで
# 上書きすると symlink が自分自身を指して無限 exec ループになるため。
ARG CLAUDE_CODE_VERSION=latest
ARG INSTALL_CLAUDE_CODE=false
USER root
# 後段 heredoc の単一引用句は意図通り（ラッパー側で実行時に $ANTHROPIC_API_KEY /
# $CLAUDE_CODE_OAUTH_TOKEN を評価させるため、ビルド時に展開してはならない）。
# hadolint ignore=SC2016
RUN if [ "$INSTALL_CLAUDE_CODE" = "true" ]; then \
		set -eux; \
		npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}; \
		npm cache clean --force; \
		cp "$(readlink -f "$(npm prefix -g)/bin/claude")" /usr/local/lib/claude-real; \
		chmod +x /usr/local/lib/claude-real; \
		{ \
			echo '#!/bin/sh'; \
			echo 'if [ -z "$ANTHROPIC_API_KEY" ] && [ -z "$CLAUDE_CODE_OAUTH_TOKEN" ]; then'; \
			echo '  echo "claude: 認証用 env (ANTHROPIC_API_KEY / CLAUDE_CODE_OAUTH_TOKEN) が未設定のため起動しません。" >&2'; \
			echo '  exit 1'; \
			echo 'fi'; \
			echo 'exec /usr/local/lib/claude-real "$@"'; \
		} > /usr/local/bin/claude; \
		chmod +x /usr/local/bin/claude; \
	fi
USER node
